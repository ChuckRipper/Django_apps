# Skopiuj do .env (NIE commituj .env). Używane przez docker-compose.
DJANGO_DEBUG=0
# Wygeneruj: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=zmien-mnie-na-co-najmniej-50-losowych-znakow
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Lokalny docker-compose działa po HTTP – wyłącz przekierowanie na HTTPS tylko tutaj.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_ADMIN_URL=zaplecze-admin/
POSTGRES_DB=krag
POSTGRES_USER=krag
POSTGRES_PASSWORD=zmien-mnie
DATABASE_URL=postgres://krag:zmien-mnie@db:5432/krag
# Hasło kont testowych tworzonych przez `dane_demo` na produkcji (min. 12 znaków).
DJANGO_DEMO_HASLO=
